<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<title>二维码生成器</title>
<style>
  :root {
    --bg: #f5f7fb;
    --card: #ffffff;
    --fg: #0f172a;
    --muted: #64748b;
    --line: #e2e8f0;
    --field: #f8fafc;
    --brand: #2563eb;
    --brand-press: #1d4ed8;
    --danger: #dc2626;
    --shadow: 0 10px 30px rgba(15, 23, 42, .08);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0b1120;
      --card: #111a2e;
      --fg: #e6edff;
      --muted: #93a4c0;
      --line: #22304d;
      --field: #0e1729;
      --brand: #3b82f6;
      --brand-press: #2563eb;
      --danger: #f87171;
      --shadow: 0 10px 30px rgba(0, 0, 0, .45);
    }
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html, body { height: 100%; }
  body {
    margin: 0;
    padding: 16px;
    padding-bottom: calc(16px + env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
          "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
    -webkit-text-size-adjust: 100%;
  }
  .card {
    width: 100%;
    max-width: 460px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: var(--shadow);
    padding: 22px 20px calc(22px + env(safe-area-inset-bottom));
  }
  h1 { margin: 0 0 4px; font-size: 20px; line-height: 1.3; letter-spacing: .2px; }
  .sub { margin: 0 0 18px; font-size: 13px; color: var(--muted); }
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  textarea {
    width: 100%;
    min-height: 92px;
    resize: vertical;
    padding: 12px 14px;
    font: inherit;
    font-size: 16px;            /* 防止 iOS 聚焦时自动放大 */
    color: var(--fg);
    background: var(--field);
    border: 1px solid var(--line);
    border-radius: 12px;
    outline: none;
    transition: border-color .15s, box-shadow .15s;
  }
  textarea::placeholder { color: var(--muted); }
  textarea:focus { border-color: var(--brand); box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 22%, transparent); }
  .row { display: flex; gap: 10px; margin-top: 14px; }
  button {
    font: inherit;
    font-size: 16px;
    border-radius: 12px;
    border: 1px solid transparent;
    padding: 13px 18px;
    cursor: pointer;
    transition: background-color .15s, opacity .15s;
    -webkit-tap-highlight-color: transparent;
  }
  button:focus-visible { outline: 3px solid color-mix(in srgb, var(--brand) 35%, transparent); outline-offset: 2px; }
  .primary { flex: 1 1 auto; color: #fff; background: var(--brand); font-weight: 600; }
  .primary:hover:not(:disabled) { background: var(--brand-press); }
  .primary:disabled { opacity: .5; cursor: not-allowed; }
  .ghost { flex: 0 0 auto; color: var(--fg); background: transparent; border-color: var(--line); }
  .ghost:hover { background: var(--field); }
  .status { min-height: 20px; margin: 12px 2px 0; font-size: 13px; color: var(--muted); }
  .status.error { color: var(--danger); }
  .result { margin-top: 6px; text-align: center; }
  .qrbox { display: flex; justify-content: center; padding: 6px 0 2px; }
  #canvas {
    display: block;
    max-width: 100%;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 1px 6px rgba(15, 23, 42, .16);
  }
  .download {
    display: inline-block;
    margin-top: 14px;
    padding: 11px 18px;
    font-size: 15px;
    color: var(--fg);
    text-decoration: none;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .download:hover { background: var(--field); }
  .foot { margin: 16px 0 0; font-size: 12px; color: var(--muted); text-align: center; }
  @media (max-width: 360px) {
    .card { padding: 18px 14px; }
    h1 { font-size: 18px; }
  }
</style>
</head>
<body>
<main class="card">
  <h1>二维码生成器</h1>
  <p class="sub">输入文本或网址，点击按钮即可生成二维码。</p>
  <label class="sr-only" for="text">要生成二维码的内容</label>
  <textarea id="text" rows="4" placeholder="例如：https://example.com" autocomplete="off" autocapitalize="off" spellcheck="false"></textarea>
  <div class="row">
    <button id="gen" class="primary" type="button" disabled>生成二维码</button>
    <button id="clear" class="ghost" type="button">清空</button>
  </div>
  <p id="status" class="status" role="status" aria-live="polite"></p>
  <div id="result" class="result" hidden>
    <div class="qrbox" id="qrbox"><canvas id="canvas" aria-label="生成的二维码"></canvas></div>
    <a id="download" class="download" download="qrcode.png">下载 PNG</a>
  </div>
  <p class="foot">内容仅在本地浏览器生成，不会上传到服务器。</p>
</main>
<noscript>
  <p style="text-align:center">此工具需要启用 JavaScript 才能生成二维码。</p>
</noscript>
<script>
(function () {
  'use strict';
  /* ---------- 元素 ---------- */
  var textEl   = document.getElementById('text');
  var genBtn   = document.getElementById('gen');
  var clearBtn = document.getElementById('clear');
  var statusEl = document.getElementById('status');
  var resultEl = document.getElementById('result');
  var qrboxEl  = document.getElementById('qrbox');
  var canvas   = document.getElementById('canvas');
  var dlEl     = document.getElementById('download');
  /* ---------- 配置 ---------- */
  // qrcode-generator（kazuhikoarase，MIT）的多个镜像，按顺序回退，任一可用即可
  var CDN = [
    'https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js',
    'https://cdn.staticfile.net/qrcode-generator/1.4.4/qrcode.min.js',
    'https://cdn.bootcdn.net/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js',
    'https://unpkg.com/qrcode-generator@1.4.4/qrcode.js',
    'https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js'
  ];
  var ECC = 'M';                 // 纠错级别：L/M/Q/H
  var MAX_BYTES = 2331;          // 纠错级别 M 下二维码可容纳的最大字节数
  var DARK = '#0f172a';
  var LIGHT = '#ffffff';
  var libReady = false;
  var currentText = '';
  var resizeTimer = null;
  /* ---------- 小工具 ---------- */
  function setStatus(msg, kind) {
    statusEl.textContent = msg || '';
    statusEl.className = 'status' + (kind ? ' ' + kind : '');
  }
  function byteLength(str) {
    if (window.TextEncoder) return new TextEncoder().encode(str).length;
    return unescape(encodeURIComponent(str)).length;
  }
  function loadScript(src) {
    return new Promise(function (resolve, reject) {
      var s = document.createElement('script');
      s.src = src;
      s.async = true;
      s.onload = function () { resolve(src); };
      s.onerror = function () { reject(new Error('加载失败：' + src)); };
      document.head.appendChild(s);
    });
  }
  // 依次尝试各个 CDN，全部失败才报错
  function loadLib(i) {
    i = i || 0;
    if (i >= CDN.length) return Promise.reject(new Error('所有 CDN 均不可用'));
    return loadScript(CDN[i]).catch(function () { return loadLib(i + 1); });
  }
  /* ---------- 渲染 ---------- */
  // 把二维码矩阵画到画布上；cell 为每个模块的像素边长（整数，避免边缘模糊）
  function drawTo(target, qr, cell, margin) {
    var count = qr.getModuleCount();
    var size = (count + margin * 2) * cell;
    target.width = size;
    target.height = size;
    var ctx = target.getContext('2d');
    ctx.fillStyle = LIGHT;
    ctx.fillRect(0, 0, size, size);
    ctx.fillStyle = DARK;
    for (var r = 0; r < count; r++) {
      for (var c = 0; c < count; c++) {
        if (qr.isDark(r, c)) {
          ctx.fillRect((c + margin) * cell, (r + margin) * cell, cell, cell);
        }
      }
    }
    return size;
  }
  function render(text) {
    // 让 Byte 模式写入 UTF-8 字节，中文等多字节字符才正确
    if (qrcode.stringToBytesFuncs && qrcode.stringToBytesFuncs['UTF-8']) {
      qrcode.stringToBytes = qrcode.stringToBytesFuncs['UTF-8'];
    }
    var qr = qrcode(0, ECC);   // 0 = 自动选择可容纳内容的最小版本
    qr.addData(text);
    qr.make();
    var count = qr.getModuleCount();
    var margin = count >= 57 ? 2 : 4;   // 大版本留白少一点，整图不至于过大
    var cssTarget = Math.max(180, Math.min(320, Math.floor(qrboxEl.clientWidth || 280)));
    var dpr = Math.min(window.devicePixelRatio || 1, 3);
    var cell = Math.max(1, Math.floor((cssTarget * dpr) / (count + margin * 2)));
    var px = drawTo(canvas, qr, cell, margin);
    canvas.style.width = (px / dpr) + 'px';
    canvas.style.height = (px / dpr) + 'px';
    // 下载用高清图：整数倍放大到 1000px 左右
    var out = document.createElement('canvas');
    drawTo(out, qr, Math.max(4, Math.round(1024 / (count + margin * 2))), margin);
    dlEl.href = out.toDataURL('image/png');
  }
  function generate() {
    if (!libReady) return;
    var raw = textEl.value;
    var text = raw.trim();
    if (!text) {
      resultEl.hidden = true;
      setStatus('请先输入内容。', 'error');
      textEl.focus();
      return;
    }
    var bytes = byteLength(text);
    if (bytes > MAX_BYTES) {
      resultEl.hidden = true;
      setStatus('内容过长：' + bytes + ' 字节，当前纠错级别最多支持 ' + MAX_BYTES + ' 字节。', 'error');
      return;
    }
    try {
      resultEl.hidden = false;   // 先显示出来，render 才能量到可用宽度
      render(text);
      currentText = text;
      setStatus('已生成（' + bytes + ' 字节，' + text.length + ' 字符）。');
    } catch (err) {
      resultEl.hidden = true;
      setStatus('生成失败：' + (err && err.message ? err.message : '内容过长'), 'error');
    }
  }
  /* ---------- 事件 ---------- */
  genBtn.addEventListener('click', generate);
  clearBtn.addEventListener('click', function () {
    textEl.value = '';
    currentText = '';
    resultEl.hidden = true;
    dlEl.removeAttribute('href');
    setStatus('');
    textEl.focus();
  });
  // 桌面端：Ctrl / Cmd + Enter 快捷生成
  textEl.addEventListener('keydown', function (e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      generate();
    }
  });
  // 尺寸变化后按新的宽度重绘，保持清晰
  window.addEventListener('resize', function () {
    if (resultEl.hidden || !currentText) return;
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      try {
        render(currentText);
      } catch (err) {
        /* 忽略重绘失败，保留原图 */
      }
    }, 200);
  });
  /* ---------- 初始化：加载二维码库 ---------- */
  setStatus('正在加载二维码库…');
  loadLib().then(function () {
    if (typeof window.qrcode !== 'function') {
      throw new Error('二维码库未正确加载');
    }
    libReady = true;
    genBtn.disabled = false;
    setStatus('');
  }).catch(function () {
    libReady = false;
    genBtn.disabled = true;
    setStatus('二维码库加载失败，请检查网络后刷新页面重试。', 'error');
  });
})();
</script>
</body>
</html>
